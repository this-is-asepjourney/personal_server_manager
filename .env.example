# ==========================================
# Personal Server Manager (PSM) Environment
# ==========================================

# Environment Mode
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL)
# Note: For instant local testing without Docker, SQLite fallback is supported: sqlite:///./psm.db
POSTGRES_DB=psm
POSTGRES_USER=psm
POSTGRES_PASSWORD=psm_super_secret_password_change_in_production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://psm:psm_super_secret_password_change_in_production@postgres:5432/psm

# Security & Tokens
# Generate via: openssl rand -hex 32
SECRET_KEY=b8f36a89270df8417727e025170d1fa78f5f4d8520857ef51fa930f785b96a4e
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Encryption key for sensitive project environment variables (Fernet key, 32 url-safe base64-encoded bytes)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=dGhpcy1pcy1hLXNhbXBsZS1mZXJuZXQta2V5LTMyeS0=

# Ports for Homelab integration
WEB_PORT=3005
API_PORT=8000
PROMETHEUS_PORT=9001

# URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
CONTROL_PLANE_URL=http://localhost:8000
CONTROL_PLANE_WS=ws://localhost:8000/api/v1/agents/connect

# Storage paths
UPLOAD_STORAGE_PATH=/opt/psm/workspaces/uploads
RELEASE_STORAGE_PATH=/opt/psm/releases
